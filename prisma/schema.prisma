generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  THERAPIST
}

enum AppointmentStatus {
  HOLD
  HOLD_EXPIRED
  PAYMENT_FAILED
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  NOT_REQUIRED
}

enum BookingType {
  ONE_TIME
  RECURRING
}

enum RecurrenceFrequency {
  NONE
  DAILY
  WEEKLY
  BI_WEEKLY
  MONTHLY
}

enum AppointmentCategory {
  FOLLOW_UP
  CONSULTATION_CBT
  INITIAL_INTAKE
  GENERAL_COUNSELING
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(PATIENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  schedules             TherapistSchedule[]         @relation("TherapistSchedules")
  availabilitySlots     TherapistAvailabilitySlot[] @relation("TherapistAvailabilitySlots")
  patientAppointments   Appointment[]               @relation("PatientAppointments")
  therapistAppointments Appointment[]               @relation("TherapistAppointments")
}

model TherapistSchedule {
  id             String    @id @default(uuid())
  therapistId    String
  dayOfWeek      Int       // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime      String    // "09:00" (HH:mm format)
  endTime        String    // "17:00" (HH:mm format)
  slotDuration   Int       // Duration in minutes, e.g., 50
  bufferDuration Int       @default(10) // Inter-session buffer in minutes, e.g., 10
  breakStartTime String?   // "12:00" (HH:mm format)
  breakEndTime   String?   // "13:00" (HH:mm format)
  isActive       Boolean   @default(true)
  effectiveFrom  DateTime  @default(now())
  effectiveUntil DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  therapist User @relation("TherapistSchedules", fields: [therapistId], references: [id], onDelete: Cascade)

  @@index([therapistId, dayOfWeek])
  @@index([therapistId, isActive, effectiveFrom])
}

model TherapistAvailabilitySlot {
  id              String   @id @default(uuid())
  therapistId     String
  date            String   // "YYYY-MM-DD"
  startTime       String   // "09:00"
  endTime         String   // "10:00"
  appointmentType String?
  isRecurring     Boolean  @default(false)
  repeatType      String?
  repeatFrequency String?
  recurrenceEndDate String? // "YYYY-MM-DD"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  therapist User @relation("TherapistAvailabilitySlots", fields: [therapistId], references: [id], onDelete: Cascade)

  @@index([therapistId, date])
}

model Appointment {
  id                  String              @id @default(uuid())
  patientId           String
  therapistId         String
  bookingType         BookingType         @default(ONE_TIME)
  seriesId            String?             // Shared UUID for recurring appointments
  recurrenceFrequency RecurrenceFrequency @default(NONE)
  recurrenceEndDate   DateTime?
  appointmentStatus   AppointmentStatus   @default(HOLD)
  paymentStatus       PaymentStatus       @default(PENDING)
  holdExpiresAt       DateTime?
  startTime           DateTime
  endTime             DateTime
  notes               String?             // Patient's session focus / clinical notes
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  patient   User @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  therapist User @relation("TherapistAppointments", fields: [therapistId], references: [id], onDelete: Cascade)

  @@index([therapistId, startTime, endTime])
  @@index([patientId])
  @@index([seriesId])
}

model RefreshSession {
  id                 String   @id @default(uuid())
  userId             String
  tokenHash          String   @unique
  expiresAt          DateTime
  revokedAt          DateTime?
  replacedBySessionId String?
  lastUsedAt         DateTime?
  userAgent          String?
  ipAddress          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt, revokedAt])
}

model IdempotencyKey {
  key        String   @id
  response   String   // JSON stringified response payload
  statusCode Int
  createdAt  DateTime @default(now())
}
